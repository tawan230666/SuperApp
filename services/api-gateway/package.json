{
  "name": "@tipkhun/api-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run --exclude src/integration.test.ts --exclude src/paper.integration.test.ts --exclude src/portfolio.integration.test.ts",
