    "zod": "^3.25.76",
    "@tipkhun/auth": "workspace:*",
    "@tipkhun/database": "workspace:*",
    "@tipkhun/risk-data": "workspace:*"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "supertest": "^7.1.1",
    "@types/supertest": "^6.0.3"
  }
